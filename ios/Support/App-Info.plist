<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key>
    <string>Rayfish</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>xyz.rayfish.ios</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>rayfish</string>
            </array>
        </dict>
    </array>
    <key>ITSAppUsesNonExemptEncryption</key>
    <true/>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <key>LSSupportsOpeningDocumentsInPlace</key>
    <false/>
    <key>NSCameraUsageDescription</key>
    <string>Rayfish scans invite and pairing QR codes with the camera.</string>
    <key>NSLocalNetworkUsageDescription</key>
    <string>Rayfish finds peers on your local network to connect to them directly.</string>
    <key>UIAppFonts</key>
    <array>
        <string>ChakraPetch-Regular.ttf</string>
        <string>ChakraPetch-SemiBold.ttf</string>
        <string>ChakraPetch-Bold.ttf</string>
        <string>IBMPlexMono-Regular.ttf</string>
        <string>PressStart2P-Regular.ttf</string>
    </array>
    <key>UIApplicationSceneManifest</key>
    <dict>
        <key>UIApplicationSupportsMultipleScenes</key>
        <false/>
    </dict>
    <key>UIFileSharingEnabled</key>
    <true/>
    <key>UILaunchScreen</key>
    <dict>
        <key>UIColorName</key>
        <string>LaunchBackground</string>
    </dict>
    <key>UIRequiredDeviceCapabilities</key>
    <array>
        <string>arm64</string>
    </array>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>
    <key>UIUserInterfaceStyle</key>
    <string>Dark</string>
    <key>RayfishSentryDSN</key>
    <string>$(RAYFISH_SENTRY_DSN)</string>
    <key>RayfishGitSHA</key>
    <string>$(RAYFISH_GIT_SHA)</string>
</dict>
</plist>
